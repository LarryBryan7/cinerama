# Copia este archivo a .env y reemplaza los valores. .env nunca se versiona.
# Todos los valores de ejemplo son ficticios.

# ── SQL Server ──────────────────────────────────────────────
# Debe cumplir la política de complejidad de SQL Server (8+ caracteres, mayúsculas, minúsculas, números y símbolos).
# Evita el carácter ';' porque se inserta en una cadena de conexión.
MSSQL_SA_PASSWORD=Change_me_123!
CINERAMA_DB_NAME=Cinerama

# ── JWT ─────────────────────────────────────────────────────
# Mínimo 32 caracteres aleatorios. Generar con: openssl rand -base64 48
JWT__SIGNINGKEY=replace-with-a-long-random-secret-of-at-least-32-chars
JWT__ISSUER=cinerama-api
JWT__AUDIENCE=cinerama-clients

# ── Ticket (QR) ─────────────────────────────────────────────
# Clave HMAC que firma el contenido del QR. Distinta de la clave JWT. Mínimo 32 caracteres aleatorios.
TICKET__SIGNINGKEY=replace-with-another-long-random-secret-of-at-least-32-chars

# ── Puerto de la API en tu máquina (http://localhost:<API_PORT>) ──
API_PORT=8090

# ── CORS ────────────────────────────────────────────────────
# Orígenes del panel web separados por coma. Nunca '*': se usan credenciales.
CORS__ALLOWEDORIGINS=http://localhost:5173

# ── Cuentas demo (datos ficticios) ──────────────────────────
# Usuarios: admin@cinerama.test y cliente1@cinerama.test … cliente20@cinerama.test
SEED__ADMINPASSWORD=Admin_demo_2026
SEED__CUSTOMERPASSWORD=Cliente_demo_2026

# ── Próximas fases (todavía sin uso) ────────────────────────
# REDIS__CONNECTIONSTRING=redis:6379   fase 6

# ── YouTube (opcional) ──────────────────────────────────────
# Clave de la "YouTube Data API v3" (Google Cloud Console → APIs y servicios → Credenciales → Crear clave de API, restringida a esa API).
# Solo se usa en el servidor para leer los comentarios de los tráileres; la app móvil nunca la ve. Sin clave, esa sección se oculta.
YOUTUBE__APIKEY=
