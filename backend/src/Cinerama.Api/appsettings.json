{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "cinerama-api",
    "Audience": "cinerama-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cinema": {
    "TimeZone": "America/Lima",
    "CancellationHours": 2
  },
  "Seating": {
    "LockMinutes": 5,
    "MaxSeatsPerUser": 10,
    "CleanupSeconds": 30,
    "CleanupEnabled": true
  },
  "Cors": {
    "AllowedOrigins": ""
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "SeatsPermitPerMinute": 60,
    "ReviewsPermitPerMinute": 10
  },
  "Media": {
    "RootPath": "media"
  },
  "WebSession": {
    "RefreshCookieName": "cinerama_rt",
    "RefreshCookieSecure": true
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": false
  }
}
