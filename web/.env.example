# Dirección base de la API (incluye /api/v1). El panel y la API deben compartir el mismo "site" para que la cookie
# SameSite=Strict del refresh token viaje (ADR-006): en desarrollo, localhost:5173 y localhost:8090 lo son.
VITE_API_URL=http://localhost:8090/api/v1

# Zona horaria del cine (la misma que Cinema:TimeZone en la API). Las horas de las funciones se escriben y se muestran en esta zona.
VITE_CINEMA_TIMEZONE=America/Lima
